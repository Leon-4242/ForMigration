[Unit]
Description=Korjik test Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/Korjik_test

ExecStart=/bin/bash -c 'source /root/Korjik_test/.venv/bin/activate && python3 /root/Korjik_test/src/main.py'

Restart=always
RestartSec=3

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
